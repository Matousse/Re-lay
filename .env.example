# LLM provider (Anthropic) — optionnel : sans clé, la démo tourne sur les fakes
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# Sillage public API (Settings → API Keys) — optionnel : sans clé, signaux mockés
SILLAGE_API_KEY=<YOUR_SILLAGE_SK_LIVE_KEY>

FULL_ENRICH_API_KEY=<YOUR_FULL_ENRICH_API_KEY>

# Slack incoming webhook — optionnel : défini, chaque play approuvé est posté
# dans le canal ; absent, l'approbation saute simplement la notification.
SLACK_WEBHOOK_URL=<YOUR_SLACK_WEBHOOK_URL>
