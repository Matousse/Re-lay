# LLM provider (Anthropic) — optionnel : sans clé, la démo tourne sur les fakes
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# Sillage public API (Settings → API Keys) — optionnel : sans clé, signaux mockés
SILLAGE_API_KEY=<YOUR_SILLAGE_SK_LIVE_KEY>

FULL_ENRICH_API_KEY=<YOUR_FULL_ENRICH_API_KEY>

# Slack incoming webhook — optionnel : défini, chaque événement notable (play
# approuvé, revue demandée) est posté dans le canal ; absent, l'événement
# saute simplement ce canal.
SLACK_WEBHOOK_URL=<YOUR_SLACK_WEBHOOK_URL>

# Resend (email sortant) — optionnel : clé + destinataire définis, chaque
# événement notable part aussi par email ; l'un des deux absent, le canal
# email est un no-op. RESEND_FROM est optionnel (défaut : le sender de test
# Resend "Re:lay <onboarding@resend.dev>", zéro config DNS).
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
NOTIFY_EMAIL_TO=<TEAM_OR_OWNER_EMAIL>
# RESEND_FROM=Re:lay <notifications@votre-domaine.fr>
